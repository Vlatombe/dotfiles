# Copied from gpg-agent-plugin
GPG_ENV=$HOME/.gnupg/gpg-agent.env
if [ -f "${GPG_ENV}" ]; then
    . ${GPG_ENV} > /dev/null
    export GPG_AGENT_INFO
    export SSH_AUTH_SOCK
    export SSH_AGENT_PID
fi

