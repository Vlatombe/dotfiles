function login_ecr() {
  if [ "$#" -lt 1 ]; then
    echo "Usage: login_ecr <profile> [tool=docker,helm,skopeo...]"
    return 1
  fi
  export AWS_PROFILE=${1:?}
  export AWS_DEFAULT_REGION=us-east-1
  tool="${2:-docker}"
  if [ "$tool" = "helm" ]
  then
    toolcmd="helm registry"
  else
    toolcmd="$tool"
  fi
  aws sso login
  aws ecr get-login-password | ${=toolcmd} login --username AWS --password-stdin $(aws sts get-caller-identity --query Account --output text).dkr.ecr.${AWS_DEFAULT_REGION}.amazonaws.com
}

function clone() {
  projectsHome=~/projects/github.com
  orgs=(calculi-corp cloudbees-io cloudbees jenkinsci)

  if [ "$#" -ne 1 ]; then
      echo "Clones a given github repository to $projectsHome/ORG/REPO"
      echo "Usage: clone [ORG/]<REPO> or clone <URL>"
      return 0
  fi
  if [[ $1 =~ 'https://github.com/([^;]+)/([^;]+)' || $1 =~ '([^;]+)/([^;]+)' ]]; then
      org=$match[1]
      repo=${match[2]%".git"} # Remove .git suffix if it exists
  else
      repo=$1
      for org in "${orgs[@]}"; do
          echo "Trying $org org"
          if clone $org/$repo; then
              return 0
          fi
      done
      return 0
  fi

  if ! [ -d "$projectsHome/$org/$repo" ]; then
      gh repo clone $org/$repo "$projectsHome/$org/$repo" -- --recurse-submodules
  else
      echo "$projectsHome/$org/$repo already exists; pulling"
      (cd "$projectsHome/$org/$repo"; git pull)
  fi
  if ! [ -d "$projectsHome/$org/$repo" ]; then
    return 1
  else
    cd "$projectsHome/$org/$repo"
  fi
  [ "$(gh repo set-default --view)" != "$org/$repo" ] && gh repo set-default $org/$repo
  [ -f .gitmodules ] && git submodule update --init
  gh repo fork --remote --clone
  spotless_git_setup
}

