function set_up_debug_cjoc() {
  local pods; pods=($(kubectl get po -l com.cloudbees.cje.tenant=cjoc -o name))
  local port=4005
  for pod in $pods; do
    debug_clean $port
    kubectl port-forward $pod $port:5005 &
    port=$((port+1))
  done
}

