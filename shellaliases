function spotless_git_setup() {
  local hooks="$(git rev-parse --git-path hooks)"
  local pre_commit_hook="$HOME/.dotfiles/git-hooks/spotless-pre-commit"
  if [ "$(readlink -f "$hooks/pre-commit")" = "$pre_commit_hook" ]; then
    echo "Spotless pre-commit hook already set up"
    return
  else
    echo "Setting up spotless pre-commit hook"
    rm -f "$hooks/pre-commit"
    ln -s "$pre_commit_hook" "$hooks/pre-commit"
  fi
}

