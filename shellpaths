########################################################################
# Shell agnostic path setup
########################################################################

PATH=/usr/local/sbin:$PATH

# My Scripts
PATH=$PATH:.
PATH=~/bin:$PATH
PATH=$PATH:~/.dotfiles/scripts

# Dev
PATH=~/.rbenv/bin:$PATH

# Put GNU utils before Mac OS ones
PATH=/usr/local/opt/coreutils/libexec/gnubin:$PATH
PATH=/usr/local/opt/gnu-tar/libexec/gnubin:$PATH
PATH=/usr/local/opt/openssl@1.1/bin:$PATH

# Git Tools
PATH=$PATH:/Applications/Dev/jgit

# Krew
PATH=${KREW_ROOT:-$HOME/.krew}/bin:$PATH

# PSE
PATH=$PATH:~/Projects/Cloudbees/dna/scripts
PATH=$PATH:~/Projects/Cloudbees/cloud-platform-v1/cli/scripts

# OPS
PATH=$PATH:~/Projects/Cloudbees/devops-ninja-tools/bin/aws

#Secrets
PATH=$PATH:~/Projects/Secrets/secrets-api/bin

# GO
PATH=$PATH:$GOPATH/bin

# Ruby
PATH="/usr/local/opt/ruby/bin:$PATH"
PATH="/usr/local/lib/ruby/gems/3.0.0/bin:$PATH"

export PATH
