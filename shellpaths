########################################################################
# Shell agnostic path setup
########################################################################

PATH=/usr/local/sbin:$PATH

# My Scripts
PATH=$PATH:.
PATH=~/bin:$PATH
# Rust executables
PATH=~/.cargo/bin:$PATH
PATH=$PATH:~/.dotfiles/scripts

# Dev
PATH=~/.rbenv/bin:$PATH

# Put GNU utils before Mac OS ones  
PATH="/opt/homebrew/opt/coreutils/libexec/gnubin:$PATH"
PATH="/opt/homebrew/opt/gnu-tar/libexec/gnubin:$PATH"
PATH="/opt/homebrew/opt/gnu-sed/libexec/gnubin:$PATH"
PATH="/opt/homebrew/opt/openssl@3/bin:$PATH"
PATH="/opt/homebrew/opt/git/bin:$PATH"

# Git Tools
PATH=$PATH:/Applications/Dev/jgit

# Krew
PATH=${KREW_ROOT:-$HOME/.krew}/bin:$PATH

# GO
PATH=$PATH:$GOPATH/bin

# Ruby
PATH="/usr/local/opt/ruby/bin:$PATH"
PATH="/usr/local/lib/ruby/gems/3.0.0/bin:$PATH"

PATH="$HOME/.rbenv/bin:$PATH"

PATH="$HOME/.local/bin:$PATH"

export PATH